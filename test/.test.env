# Database Configuration for Testcontainers
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=auth_haven_test
DB_SSLMODE=disable
DB_MAX_CONNECTIONS=25
DB_MAX_IDLE_CONNS=5
DB_CONN_MAX_LIFETIME=5m

# Redis Configuration for Testcontainers
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Server Configuration (not needed for database testing)
HTTP_PORT=:8080
GRPC_PORT=:50051
SERVER_HOST=0.0.0.0

# Auth Configuration (not needed for database testing)
JWT_PRIVATE_KEY=
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=168h
TEMP_TOKEN_TTL=10m
SESSION_TTL=24h

# Security Configuration (not needed for database testing)
PASSWORD_MIN_LENGTH=12
PASSWORD_REQUIRE_UPPER=true
PASSWORD_REQUIRE_LOWER=true
PASSWORD_REQUIRE_NUMBER=true
PASSWORD_REQUIRE_SPECIAL=true
MAX_LOGIN_ATTEMPTS=5
ACCOUNT_LOCKOUT_DURATION=15m
MFA_ENCRYPTION_KEY=
