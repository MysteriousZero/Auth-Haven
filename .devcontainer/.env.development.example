# Example local-development configuration. Never use these credentials in production.
APP_ENV=development

# PostgreSQL
POSTGRES_DB=auth_haven
POSTGRES_USER=auth_haven
POSTGRES_PASSWORD=development-only-postgres-password
POSTGRES_PORT=5432
HOST_POSTGRES_PORT=5432

# Application database connection
DB_HOST=db
DB_PORT=5432
DB_NAME=auth_haven
DB_USER=auth_haven
DB_PASSWORD=development-only-postgres-password
DB_SSLMODE=disable

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
HOST_REDIS_PORT=6379
REDIS_PASSWORD=development-only-redis-password
REDIS_DB=0

# Security
# Base64 encoding of 32 zero bytes; suitable only for disposable local data.
MFA_ENCRYPTION_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
JWT_KEY_ID=development-ephemeral

# Server
SERVER_HOST=0.0.0.0
HTTP_PORT=:8080
GRPC_PORT=:50051
HOST_HTTP_PORT=8080
HOST_GRPC_PORT=50051
CORS_ALLOWED_ORIGINS=http://localhost:3000
